// Injected by Terraform — this environment's endpoints.
window.AIPLAT = {
  adminApi: "${admin_api_endpoint}".replace(/\/$/, ""),
  gateway: "${gateway_endpoint}".replace(/\/$/, ""),
  usageApi: "${usage_api_endpoint}".replace(/\/$/, ""),
  keyAdmin: "${keyadmin_endpoint}".replace(/\/$/, ""),
  helpApi: "${help_api_endpoint}".replace(/\/$/, ""),
  auditApi: "${audit_api_endpoint}".replace(/\/$/, ""),
  cognito: {
    region: "${region}",
    clientId: "${cognito_client_id}",
    domain: "${cognito_domain}"
  },
  // Enabled social login providers. Empty = e-mail/password only (no buttons).
  social: ("${social_providers}" === "none" || "${social_providers}" === "") ? [] : "${social_providers}".split(","),
  // BYO Bedrock (cross-account): the platform account the customer has to trust
  // when they create the AIPlatGatewayAccess role in their own account.
  platformAccount: "${platform_account}"
};
