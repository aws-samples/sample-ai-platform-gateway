      "expect": {
        "budget": {
          "monthly_usd": 10,
          "limit_usd": 10
        }
      }
    },
    {
      "name": "CORE-SEC-009 child opts into deployment cache_scope when parent declared none: defaults to team on read, rejected on write",
      "below_org": true,
      "parent": {},
      "child": {
        "cache_scope": "deployment"
      },
      "widens": [
